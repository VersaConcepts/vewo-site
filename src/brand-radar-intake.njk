title: Brand Radar Intake
description: Brand Radar intake form.
permalink: /brand-radar-intake/index.html
robots: noindex, nofollow
eleventyExcludeFromCollections: true
---
<section class="section">
  <div class="container">
    <header class="sec-head reveal">
      <h2>Brand Radar <span class="grad">Intake.</span></h2>
    </header>

    <div class="reveal" style="border:1px solid var(--line); border-radius:16px; overflow:hidden; background:#fff;">
      <iframe
        id="radar-intake-form"
        class="airtable-embed"
        src="https://airtable.com/embed/appUqrNIcJw7e4yM7/paggjDZ4HwpOzd5Jt/form"
        title="Brand Radar Intake form"
        loading="lazy"
        width="100%"
        height="900"
        style="background:transparent; border:0; display:block;">
      </iframe>
    </div>
  </div>
</section>
<script>
  // The Quick Visibility Check (app.vewo.ai/audit) links here with the prospect's answers as Airtable prefill_ / hide_
  // parameters, so the intake never asks them twice. Only those parameters are passed to the form.
  (function () {
    var q = new URLSearchParams(location.search), out = new URLSearchParams();
    q.forEach(function (v, k) { if (/^(prefill|hide)_/.test(k)) out.append(k, v); });
    var f = document.getElementById("radar-intake-form");
    if (f && out.toString()) f.src = f.src.split("?")[0] + "?" + out.toString();
  })();
</script>
