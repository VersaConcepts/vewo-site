<section class="section">
  <div class="container narrow">
    <header class="sec-head reveal">
      <span class="kicker">Get Started</span>
      <h1 class="section-h1">Let's build your<br /><span class="grad">AI visibility.</span></h1>
      <p class="sec-sub">
        Tell us about your brand. The more you share, the sharper your audit: it's the first step to
        seeing exactly where you stand in AI search, and what it takes to lead your category.
      </p>
    </header>

    <div class="intake-steps reveal">
      <div class="intake-step"><span class="intake-step__num">1</span><p>Complete the intake form below.</p></div>
      <div class="intake-step"><span class="intake-step__num">2</span><p>We review your brand the way AI sees it.</p></div>
      <div class="intake-step"><span class="intake-step__num">3</span><p>We follow up with your visibility audit and next steps.</p></div>
    </div>

    <div class="intake-embed reveal">
      <iframe
        id="radar-intake-form"
        class="airtable-embed"
        src="https://airtable.com/embed/appUqrNIcJw7e4yM7/paggjDZ4HwpOzd5Jt/form"
        title="VEWO intake form"
        frameborder="0"
        width="100%"
        height="900"
        loading="lazy"
        style="background: transparent;"></iframe>
    </div>

    <p class="audit-alt reveal">Prefer email? <a href="mailto:hello@vewo.ai">hello@vewo.ai</a></p>
  </div>
</section>
<script>
  // Same form as /brand-radar-intake/ (the one VEWO intake). Links from the Quick Visibility Check can carry the
  // prospect's answers as Airtable prefill_ / hide_ parameters; only those are passed to the form.
  (function () {
    var q = new URLSearchParams(location.search), out = new URLSearchParams();
    q.forEach(function (v, k) { if (/^(prefill|hide)_/.test(k)) out.append(k, v); });
    var f = document.getElementById("radar-intake-form");
    if (f && out.toString()) f.src = f.src.split("?")[0] + "?" + out.toString();
  })();
</script>
