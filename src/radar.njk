<div class="radar-page">
<style>
  .radar-page .r-eyebrow { display:inline-flex; align-items:center; gap:9px; font-size:0.95rem; letter-spacing:0.14em; text-transform:uppercase; font-weight:700; color:#fff; background:var(--grad); padding:11px 22px; border-radius:999px; margin-bottom:20px; box-shadow:0 12px 30px rgba(7,80,215,0.30); }
  .radar-page .r-eyebrow::before { content:""; width:9px; height:9px; border-radius:50%; background:#fff; box-shadow:0 0 0 0 rgba(255,255,255,0.7); animation:r-pulse 1.8s ease-out infinite; }
  @keyframes r-pulse { 0%{box-shadow:0 0 0 0 rgba(255,255,255,0.65);} 70%{box-shadow:0 0 0 8px rgba(255,255,255,0);} 100%{box-shadow:0 0 0 0 rgba(255,255,255,0);} }
  .radar-page .r-hero { display:grid; grid-template-columns:1.05fr 0.95fr; gap:44px; align-items:start; }
  .radar-page .r-hero h2 { font-size:clamp(1.8rem,3.6vw,2.7rem); line-height:1.14; letter-spacing:-0.02em; margin:10px 0 18px; color:var(--text); text-wrap:balance; }
  .radar-page .r-hero h2 .gradline { display:block; }
  .radar-page .r-hero .r-sub { font-size:clamp(1.05rem,2.2vw,1.3rem); font-weight:650; color:var(--text); margin:0 0 16px; }
  .radar-page .r-hero p.r-body { color:var(--muted); font-size:1.02rem; line-height:1.65; margin:0 0 20px; }
  .radar-page .r-external { border-left:4px solid var(--v3); background:var(--accent-soft, #eef4ff); border-radius:0 14px 14px 0; padding:16px 20px; margin:20px 0 0; font-size:0.98rem; line-height:1.6; color:var(--text); }
  .radar-page .r-external strong { color:var(--v3); }
  .radar-page .r-actions { display:flex; flex-wrap:wrap; gap:14px; align-items:center; }
  .radar-page .r-textlink { color:var(--v3); font-weight:700; text-decoration:none; }
  .radar-page .r-textlink:hover { text-decoration:underline; }
  @media (max-width:860px){ .radar-page .r-hero { grid-template-columns:1fr; gap:30px; } }

  /* report mockup */
  .radar-page .r-mock { border:1px solid var(--line); border-radius:20px; background:#fff; box-shadow:0 26px 64px rgba(26,36,64,0.14); overflow:hidden; }
  .radar-page .r-mock__top { background:var(--grad); color:#fff; padding:15px 20px; font-family:"Geist",sans-serif; font-weight:700; font-size:0.9rem; display:flex; justify-content:space-between; align-items:center; }
  .radar-page .r-mock__top span { font-size:0.7rem; font-weight:600; opacity:0.9; letter-spacing:0.06em; }
  .radar-page .r-mock__body { padding:18px 20px; display:grid; gap:16px; }
  .radar-page .r-mrow__head { display:flex; justify-content:space-between; align-items:center; gap:10px; }
  .radar-page .r-mrow__head b { font-size:0.9rem; color:var(--text); font-weight:650; }
  .radar-page .r-bar { height:8px; border-radius:99px; background:#eef0f4; overflow:hidden; margin-top:8px; }
  .radar-page .r-bar > i { display:block; height:100%; border-radius:99px; background:var(--grad); }
  .radar-page .r-stat { font-size:0.66rem; font-weight:700; letter-spacing:0.06em; text-transform:uppercase; padding:3px 9px; border-radius:6px; white-space:nowrap; }
  .radar-page .r-stat--up { color:#08734a; background:rgba(16,160,110,0.12); }
  .radar-page .r-stat--down { color:#a8452b; background:rgba(192,86,58,0.12); }
  .radar-page .r-stat--watch { color:var(--muted); background:#eef0f4; }
  .radar-page .r-mock__foot { border-top:1px solid var(--line); padding:12px 20px; font-size:0.72rem; color:var(--muted-2); text-align:center; letter-spacing:0.04em; }

  /* generic radar cards + grids */
  .radar-page .r-grid { display:grid; gap:18px; }
  .radar-page .r-grid--2 { grid-template-columns:repeat(2,1fr); }
  .radar-page .r-grid--3 { grid-template-columns:repeat(3,1fr); }
  @media (max-width:820px){ .radar-page .r-grid--2, .radar-page .r-grid--3 { grid-template-columns:1fr; } }
  .radar-page .r-card { border:1px solid var(--line); border-radius:18px; background:#fff; padding:26px 24px; box-shadow:var(--shadow); }
  .radar-page .r-card h3 { font-size:1.12rem; margin:0 0 8px; color:var(--text); }
  .radar-page .r-card h4 { font-size:0.72rem; letter-spacing:0.12em; text-transform:uppercase; color:var(--v3); font-weight:700; margin:0 0 10px; }
  .radar-page .r-card p { color:var(--muted); margin:0; font-size:0.97rem; line-height:1.55; }

  /* executive questions */
  .radar-page .r-qgrid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:12px; margin-top:8px; }
  @media (max-width:820px){ .radar-page .r-qgrid { grid-template-columns:1fr; } }
  .radar-page .r-q { border:1px solid var(--line); border-radius:12px; background:var(--bg-2); padding:14px 16px; font-weight:600; color:var(--text); font-size:0.95rem; line-height:1.4; }

  /* example intelligence cards */
  .radar-page .r-opp { font-size:0.94rem; color:var(--text); margin:14px 0 12px; }
  .radar-page .r-opp b { color:var(--v3); }
  .radar-page .r-badge { display:inline-block; font-family:"Geist",sans-serif; font-weight:700; font-size:0.68rem; letter-spacing:0.12em; padding:6px 13px; border-radius:999px; background:var(--grad); color:#fff; }
  .radar-page .r-illus { display:block; font-size:0.66rem; color:var(--muted-2); margin-top:12px; text-transform:uppercase; letter-spacing:0.08em; }

  /* waitlist */
  .radar-page .field--spotlight label { color:var(--v3); font-weight:700; }
  .radar-page .field--spotlight textarea { border-color:#bcd0f7; background:#f5f9ff; min-height:92px; }
  .radar-page .r-formwrap { max-width:720px; margin:0 auto; }

  /* the floating waitlist button: follows the visitor down the page, hides at the opening CTA and at the form */
  .radar-page .r-float { position:fixed; right:22px; bottom:22px; z-index:40; box-shadow:0 14px 34px rgba(7,80,215,0.35); transition:opacity 180ms, transform 180ms; }
  .radar-page .r-float[hidden] { display:inline-flex !important; opacity:0; transform:translateY(12px); pointer-events:none; }
  @media (max-width:640px){ .radar-page .r-float { left:16px; right:16px; bottom:14px; width:auto; justify-content:center; } }
  @media (prefers-reduced-motion: reduce){ .radar-page .r-float { transition:none; } }
</style>

