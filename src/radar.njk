<!-- 5. JOIN THE WAITLIST -->
<section class="section section--cta" id="radar-waitlist">
 <div class="container narrow">
  <header class="sec-head reveal">
   <span class="kicker">Join the Waitlist</span>
   <h2>Be first to see the market around your brand <span class="grad">more clearly.</span></h2>
   <p class="sec-sub">VEWO Content is available now. Radar opens next, then the rest of VEWO. Waitlist members get early access and hear first as each product opens. Built for growing consumer and ecommerce brands that have outgrown guessing.</p>
  </header>

  <div class="r-formwrap reveal">
   <form class="audit-form" id="radarForm" action="https://app.vewo.ai/api/waitlist" method="POST" novalidate>
    <input type="checkbox" name="botcheck" class="hidden" style="display:none" tabindex="-1" autocomplete="off" aria-hidden="true" />
    <div class="field">
     <label for="r_first">First name</label>
     <input id="r_first" name="first_name" type="text" placeholder="First name" required />
    </div>
    <div class="field">
     <label for="r_last">Last name</label>
     <input id="r_last" name="last_name" type="text" placeholder="Last name" />
    </div>
    <div class="field">
     <label for="r_email">Work email</label>
     <input id="r_email" name="email" type="email" placeholder="you@company.com" required />
    </div>
    <div class="field">
     <label for="r_company">Company</label>
     <input id="r_company" name="company" type="text" placeholder="Your company name" />
    </div>
    <div class="field field--full">
     <label for="r_website">Company website</label>
     <input id="r_website" name="website" type="text" placeholder="yourcompany.com" />
    </div>
    <div class="field field--full field--spotlight">
     <label for="r_wish">What would you most want Radar to tell you about your market?</label>
     <textarea id="r_wish" name="radar_wishlist" placeholder="Optional, but it helps us build the right thing."></textarea>
    </div>
    <div class="field field--full" style="align-items:center">
     <button type="submit" class="btn btn--solid btn--lg">Join the Radar Waitlist</button>
     <p class="form-note" id="radarNote"></p>
    </div>
   </form>
  </div>
 </div>
</section>

<a href="#radar-waitlist" class="btn btn--solid btn--lg r-float" id="radarFloat" hidden>Join the Radar Waitlist</a>
<script>
(function () {
  // The floating button shows once the opening call to action has scrolled away, and hides again at the form and below it.
  var btn = document.getElementById("radarFloat"), top = document.getElementById("ecoCta"), form = document.getElementById("radar-waitlist");
  if (!btn || !top || !form) return;
  function sync() {
    var h = window.innerHeight;
    // Hidden while the opening button is still on screen (or above it), and from the moment the form comes into view on down.
    btn.hidden = top.getBoundingClientRect().bottom > 0 || form.getBoundingClientRect().top < h * 0.85;
  }
  window.addEventListener("scroll", sync, { passive: true });
  window.addEventListener("resize", sync);
  sync();
})();
</script>
</div>
