---
layout: layouts/base.njk
ogType: article
---
<article class="section blog-post">
  <div class="container narrow">
    <p class="blog-post__back reveal"><a href="/blog/">← Back to the blog</a></p>
    <header class="blog-post__head reveal">
      {% if category %}<span class="kicker">{{ category }}</span>{% endif %}
      <h1>{{ title }}</h1>
      {% if author %}<p class="blog-post__meta">By {{ author }}</p>{% endif %}
    </header>
    <div class="blog-post__body">
      {{ content | safe }}
    </div>

    <aside class="author-bio reveal">
      <div class="author-bio__mark" aria-hidden="true">JU</div>
      <div>
        <p class="author-bio__label">About the Author</p>
        <p class="author-bio__name">{{ author or "Jim Umlauf" }}</p>
        <p class="author-bio__text">Jim Umlauf is the founder of VEWO and an entrepreneur with a background in sales and leadership and more than 13 years of experience operating an 8 figure e-commerce brand. He believes the best strategies are built around strong execution, consistency, quality, and making complicated things easier.</p>
      </div>
    </aside>

    <div class="blog-post__cta reveal">
      <h3>Want AI to recommend your brand?</h3>
      <p>See exactly where you stand with a free visibility audit.</p>
      <a href="/#audit" class="btn btn--solid btn--lg">Get Your Free Audit</a>
    </div>
  </div>
</article>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": {{ title | dump | safe }},
  "description": {{ description | dump | safe }},
  "datePublished": "{{ page.date | isoDate }}",
  "dateModified": "{{ page.date | isoDate }}",
  "author": { "@type": "Person", "name": {{ (author or "Jim Umlauf") | dump | safe }} },
  "publisher": {
    "@type": "Organization",
    "name": "VEWO",
    "logo": { "@type": "ImageObject", "url": "https://vewo.ai/favicon-512.png" }
  },
  "image": "https://vewo.ai/favicon-512.png",
  "mainEntityOfPage": { "@type": "WebPage", "@id": "https://vewo.ai{{ page.url }}" }
}
</script>
