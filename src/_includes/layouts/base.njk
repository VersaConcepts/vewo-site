      <nav class="footer__legal" aria-label="Legal"><a href="/privacy/">Privacy</a><a href="/terms/">Terms</a><a href="/dpa/">Data Processing</a><a href="/subprocessors/">Sub-processors</a><a href="/data-deletion/">Data Deletion</a><a href="/accessibility/">Accessibility</a></nav>
