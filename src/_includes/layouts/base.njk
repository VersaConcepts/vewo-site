<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{ title }} | VEWO</title>
  <meta name="description" content="{{ description }}" />
  {% if canonical %}<link rel="canonical" href="{{ canonical }}" />{% endif %}
  <meta name="theme-color" content="#ffffff" />
  <meta name="robots" content="{{ robots or 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1' }}" />

  <meta property="og:title" content="{{ title }}" />
  <meta property="og:description" content="{{ description }}" />
  <meta property="og:type" content="{{ ogType or 'website' }}" />
  {% if canonical %}<meta property="og:url" content="{{ canonical }}" />{% endif %}
  <meta property="og:site_name" content="VEWO" />
  <meta property="og:image" content="{{ ogImage or 'https://vewo.ai/og-image.png' }}" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content="{{ ogImage or 'https://vewo.ai/og-image.png' }}" />

  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
  <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <link rel="alternate" type="application/atom+xml" href="/blog/feed.xml" title="VEWO Blog" />

  <!-- Fonts are served from vewo.ai (Inter and Geist, SIL OFL; latin): no wait on Google Fonts before the first paint. -->
  <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/geist-latin.woff2" as="font" type="font/woff2" crossorigin />
  <style>
   @font-face { font-family: "Inter"; font-style: normal; font-weight: 100 900; font-display: swap; src: url(/fonts/inter-latin.woff2) format("woff2"); unicode-range: U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD; }
   @font-face { font-family: "Geist"; font-style: normal; font-weight: 100 900; font-display: swap; src: url(/fonts/geist-latin.woff2) format("woff2"); unicode-range: U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD; }
  </style>
  <link rel="stylesheet" href="/styles.css" />

  <!-- Google Analytics and Meta Pixel: their calls queue at once (PageView included), and their ~450 KB of script
       loads at the visitor's first scroll, tap or key, or 4 s after the page has loaded, so it never slows the first view. -->
  <script>
   window.dataLayer = window.dataLayer || [];
   function gtag(){dataLayer.push(arguments);}
   gtag('js', new Date());
   gtag('config', 'G-B7B1BNDQYQ');
   !function(f){if(f.fbq)return;var n=f.fbq=function(){n.callMethod?n.callMethod.apply(n,arguments):n.queue.push(arguments)};
   if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';n.queue=[]}(window);
   fbq('init', '906319405682467');
   fbq('track', 'PageView');
   (function () {
    var started = false;
    function start() {
     if (started) return;
     started = true;
     ["https://www.googletagmanager.com/gtag/js?id=G-B7B1BNDQYQ", "https://connect.facebook.net/en_US/fbevents.js"].forEach(function (src) {
      var s = document.createElement("script"); s.async = true; s.src = src; document.head.appendChild(s);
     });
    }
    ["scroll", "pointerdown", "keydown", "touchstart"].forEach(function (e) { addEventListener(e, start, { once: true, passive: true }); });
    addEventListener("load", function () { setTimeout(start, 4000); });
   })();
  </script>
  <noscript><img height="1" width="1" style="display:none"
  src="https://www.facebook.com/tr?id=906319405682467&ev=PageView&noscript=1"/></noscript>

  {% block head %}{% endblock %}
</head>
