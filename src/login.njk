<div class="login-page">
<style>
  .login-page .login-wrap { max-width: 520px; margin: 0 auto; }
  .login-page .login-card { position: relative; border-radius: 24px; padding: 40px 36px; text-align: center;
    background: linear-gradient(#ffffff,#ffffff) padding-box, var(--grad) border-box; border: 2px solid transparent;
    box-shadow: 0 24px 60px rgba(7,80,215,0.16); }
  .login-page .login-card h2 { font-size: 1.3rem; margin: 0 0 8px; color: var(--text); }
  .login-page .login-card p.sub { color: var(--muted); margin: 0 0 22px; font-size: 0.98rem; }
  .login-page .login-list { list-style: none; display: grid; gap: 10px; text-align: left; max-width: 360px; margin: 0 auto 26px; padding: 0; }
  .login-page .login-list li { position: relative; padding-left: 28px; color: var(--text); font-size: 0.98rem; }
  .login-page .login-list li::before { content: "✓"; position: absolute; left: 0; color: var(--c-ink); font-weight: 700; }
  .login-page .login-card .btn { width: 100%; max-width: 320px; }
  .login-page .login-alt { color: var(--muted); font-size: 0.92rem; margin: 16px 0 0; }
  .login-page .login-alt a { color: var(--v3); font-weight: 600; }
</style>

<section class="section" id="login-top">
 <div class="container narrow">
  <header class="sec-head reveal">
   <span class="kicker">Client Login</span>
   <h1 class="hero__title" style="font-size:clamp(1.9rem,4vw,3rem)">Welcome <span class="grad">back.</span></h1>
   <p class="sec-sub">Log in to your VEWO dashboard to see your profile, the content we're publishing, and your visibility reports over time.</p>
  </header>

  <div class="login-wrap reveal">
   <div class="login-card">
    <h2>Your VEWO dashboard</h2>
    <p class="sub">Everything about your brand's visibility, in one place.</p>
    <ul class="login-list">
     <li>Your brand profile and priorities</li>
     <li>Content created, reviewed, and published</li>
     <li>Visibility reports across search and AI</li>
    </ul>
    <a href="https://app.vewo.ai/" class="btn btn--solid btn--lg">Log in to your dashboard</a>
    <p class="login-alt">Don't have access yet? <a href="mailto:hello@vewo.ai?subject=VEWO%20dashboard%20access">Contact us</a> to get set up.</p>
   </div>
  </div>
 </div>
</section>
